# Copy this file to .env in this same directory and fill in your own keys.
# .env is gitignored - it must never be committed.

# Required. Writes the reel concepts and revises shots.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required for rendering: stills, video and the voiceover audio.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Only needed to pull a reference reel off Instagram.
# Without it, the Instagram reference field will not work; everything else does.
# Get one at https://console.apify.com/settings/integrations
APIFY_API_TOKEN=

# Optional. Raises the token ceiling for concept generation if a long run
# gets truncated. Leave unset for the default.
# CONCEPT_MAX_TOKENS=
